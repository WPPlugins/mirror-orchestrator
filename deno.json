{
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "tasks": {
    "discover": "deno run --allow-net --allow-read --allow-write --allow-env src/discover.ts",
    "sync": "deno run --allow-all src/sync-plugin.ts",
    "backfill": "deno run --allow-net --allow-read --allow-write --allow-env src/backfill.ts",
    "test": "deno test --allow-read --allow-write tests/",
    "check": "deno check src/**/*.ts"
  }
}
